#!/bin/sh
#
# Smart Edge Camera Service daemon
# Auto-start on boot via SysVinit (/etc/init.d/S99smart_edge_camera)
#

DAEMON="/usr/bin/smart_edge_camera"
NAME="smart_edge_camera"
VIDEO_DEV="/dev/video11"
MODEL_PATH="/userdata/retinaface.rknn"

[ -x "$DAEMON" ] || exit 0
[ -f "$MODEL_PATH" ] || exit 0

LOG_FILE="/var/log/smart_edge_camera.log"

start() {
    printf "Starting %s: " "$NAME"
    
    # Wait for Rockchip ISP 3A daemon (rkaiq_3A_server) to finish sensor calibration
    cnt=0
    while [ $cnt -lt 30 ]; do
        if pidof rkaiq_3A_server >/dev/null 2>&1; then
            break
        fi
        sleep 0.2
        cnt=$((cnt + 1))
    done
    
    # Give ISP 3A hardware algorithms (AE/AWB) 1.5 seconds to establish sensor gain/exposure
    sleep 1.5

    # Rotate log file if larger than 2MB
    if [ -f "$LOG_FILE" ] && [ $(wc -c < "$LOG_FILE") -gt 2097152 ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.old"
    fi

    # Start daemon redirecting stdout and stderr to LOG_FILE
    start-stop-daemon -S -b -m -p /var/run/$NAME.pid -x /bin/sh -- -c "exec $DAEMON $VIDEO_DEV $MODEL_PATH >> $LOG_FILE 2>&1"
    echo "OK"
}

stop() {
    printf "Stopping %s: " "$NAME"
    start-stop-daemon -K -q -p /var/run/$NAME.pid || killall -9 $NAME 2>/dev/null
    rm -f /var/run/$NAME.pid
    echo "OK"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    status)
        if [ -f /var/run/$NAME.pid ] && kill -0 $(cat /var/run/$NAME.pid) 2>/dev/null; then
            echo "$NAME is running (PID: $(cat /var/run/$NAME.pid))"
        else
            echo "$NAME is stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
