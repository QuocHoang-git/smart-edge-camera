@startuml
skinparam BoxPadding 10
skinparam ParticipantPadding 10

box "Kernel Space (Hardware & Subsystems)" #LightBlue
participant "Sensor (SC3336)\nMIPI-CSI" as CSI
participant "Rockchip ISP\n(rkisp_v7 / V4L2)" as ISP
participant "Linux CMA Heap\n(/dev/rk_dma_heap)" as CMA
participant "Rockchip RGA 2D\n(/dev/rga)" as RGA
participant "Rockchip NPU\n(/dev/rknpu)" as NPU
end box

box "User Space (Firmware Application)" #LightGreen
participant "V4L2Camera\n(Producer Thread)" as PROD
participant "BoundedQueue\n(Drop-Oldest)" as QUEUE
participant "RknnEngine\n(Consumer Thread)" as CONS
end box

== Initialization Phase ==
PROD -> CMA : ioctl(DMA_HEAP_IOCTL_ALLOC, 16KB)\nAllocate Sub-Stream Buffer
CMA --> PROD : Return DMA-BUF fd (fd=8)
PROD -> ISP : ioctl(VIDIOC_REQBUFS & EXPBUF)\nExport 4x 1080p DMA-BUFs (fd=5..8)
PROD -> NPU : rknn_create_mem_from_fd(fd=8)\nrknn_set_io_mem(input & NC1HWC2 outputs)

== Real-Time Continuous Ingestion (25 FPS) ==
loop Continuous Streaming (24/7)
    CSI -> ISP : Raw Bayer Frame
    ISP -> ISP : 3A Processing (AE/AWB/Denoise)
    ISP -> PROD : ioctl(VIDIOC_DQBUF) -> Frame ready
    
    activate PROD
    PROD -> RGA : imresize_t(src_handle, dst_handle)\nZero-copy Hardware Blit (NV12 -> Gray8)
    activate RGA
    RGA --> PROD : Hardware Blit Done (~3.3ms)
    deactivate RGA
    
    PROD -> ISP : ioctl(VIDIOC_QBUF) -> Return 1080p buffer immediately
    
    PROD -> QUEUE : push(frame_seq) [Non-blocking, drop oldest]
    deactivate PROD
    
    QUEUE -> CONS : pop(frame_seq)
    activate CONS
    CONS -> NPU : rknn_run(ctx)\nZero-Copy Inference on NPU
    activate NPU
    NPU --> CONS : BlazeFace Done (~3.3ms)
    deactivate NPU
    
    opt Face Detected (Confidence > Threshold)
        CONS -> CONS : Dispatch Security Alert Event
    end
    deactivate CONS
end
@enduml
